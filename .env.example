# Local overrides (optional)
# DATABASE_PATH=./data/chm.sqlite
#
# Hosted sandbox only — browser HTTP Basic in front of the cookie logins.
# Unset locally so clone/Docker stays open. /api/health is never gated.
# SANDBOX_BASIC_USER=bbnj
# SANDBOX_BASIC_PASSWORD=
#
# Hosted webinar participant URL — force anonymous public view; refuse mutations and role switch.
# Leave unset locally so the presenter can use all five logins.
# READ_ONLY_DEMO=1
#
# Umami (analytics.glenwright.earth) — set on Fly only; leave unset locally.
# UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://analytics.glenwright.earth/script.js
